# PLANTILLA INCOMPLETA: no contiene secretos. No se puede desplegar con ella.
# Crear runtime.env fuera de Git (recomendado /etc/correspondencia/runtime.env),
# chmod 600. Seleccionarlo con CORRESPONDENCIA_ENV_FILE=/ruta/runtime.env.
# Formato admitido por scripts: NOMBRE=valor literal, sin expansion $ ni comandos.
APP_ENV=production
APP_NAME=correspondencia-api
# Compose asigna APP_VERSION desde release.json; mantener este valor vacío.
APP_VERSION=
API_PREFIX=
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
JWT_ACCESS_SECRET=
JWT_ISSUER=correspondencia-api
JWT_AUDIENCE=correspondencia-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_NAME=refresh_token
COOKIE_PATH=/auth
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
PUBLIC_TRACKING_HMAC_SECRET=
STORAGE_ROOT=/app/storage
MAX_ATTACHMENT_SIZE_MB=25
ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png,image/webp,image/gif
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true
INSTITUTIONAL_LOGO_PATH=
INSTITUTIONAL_MAYOR_POSITION_CODES=ALCALDE,ALCALDESA
# Nombres conocidos: confirmar en la inspeccion autorizada antes de operar.
# external:true impide que Compose cree silenciosamente otros volumenes.
POSTGRES_VOLUME=correspondencia_sipe_sipe_postgres_data
STORAGE_VOLUME=correspondencia_sipe_sipe_backend_storage
# Infraestructura: fijar imagen PostgreSQL 16 aprobada por digest; no inventarlo.
POSTGRES_IMAGE=
# Directorios fuera de cualquier checkout, con acceso restringido.
BACKUP_ROOT=/var/backups/correspondencia
STATE_DIR=/var/lib/correspondencia-deploy
MIN_FREE_GB=5

# Identidad operativa: completar tras inspeccion autorizada del destino.
EXPECTED_DOCKER_CONTEXT=
EXPECTED_DOCKER_DAEMON_ID=
EXPECTED_DEPLOY_REF=main
# Opcional: fija HEAD externamente sin la autorreferencia de un SHA en su commit.
EXPECTED_DEPLOY_SHA=
# Presupuesto por operacion (segundos).
COMMAND_TIMEOUT_SECONDS=60
PULL_TIMEOUT_SECONDS=1800
BACKUP_TIMEOUT_SECONDS=7200
MIGRATION_TIMEOUT_SECONDS=3600
APP_UPDATE_TIMEOUT_SECONDS=240
# Fallback solo con --allow-unestimated-backup; no garantiza que quepa el backup.
UNESTIMATED_BACKUP_MIN_GB=100
