# Plantilla: completar secretos solo en servidor, nunca en Git. chmod 600.
# Copiar a .env ignorado, o usar CORRESPONDENCIA_ENV_FILE=/etc/correspondencia/runtime.env.
APP_ENV=production
INSTALL_MODE=demo
APP_NAME=correspondencia-api
APP_VERSION=1.0.0
API_PREFIX=
DATABASE_URL=
POSTGRES_DB=correspondencia_demo
POSTGRES_USER=correspondencia_app
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
JWT_ACCESS_SECRET=
JWT_ISSUER=correspondencia-api
JWT_AUDIENCE=correspondencia-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_NAME=refresh_token
COOKIE_PATH=/auth
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
PUBLIC_TRACKING_HMAC_SECRET=
STORAGE_ROOT=/app/storage
MAX_ATTACHMENT_SIZE_MB=25
ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png,image/webp,image/gif
CORS_ALLOW_ORIGINS=https://correspondencia.sipesipe.gob.bo
CORS_ALLOW_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true
INSTITUTIONAL_LOGO_PATH=
INSTITUTIONAL_MAYOR_POSITION_CODES=ALCALDE,ALCALDESA
# Demo: volúmenes NUEVOS administrados. Para adopción ver docker-compose.adopt.yml.
POSTGRES_VOLUME=correspondencia_demo_postgres_data
STORAGE_VOLUME=correspondencia_demo_backend_storage
# Backups y lock fuera del checkout.
BACKUP_ROOT=/var/backups/correspondencia
MIN_FREE_GB=5
